{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh label list:*)",
      "Bash(gh api -X GET:*)",
      "Bash(gh api --method GET:*)",
      "Bash(gh project view:*)",
      "Bash(gh project item-list:*)",
      "Bash(bash scripts/check-md-links.sh)",
      "Bash(bash scripts/check-template-sync.sh)",
      "Bash(bash scripts/tuning-status.sh:*)",
      "Bash(bash scripts/retro-hygiene.sh:*)",
      "Bash(shellcheck:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)"
    ]
  }
}
